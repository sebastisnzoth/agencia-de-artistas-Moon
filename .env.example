# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/moon?schema=public"

# Public production origin, e.g. https://moon.example.com
MOON_APP_URL="http://localhost:3000"

# Minimum 32 random characters. Used only for signed session/state JWTs.
MOON_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Exactly 32 random bytes encoded as base64. Used for AES-256-GCM refresh-token encryption.
# Generate locally: openssl rand -base64 32
MOON_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Google Cloud OAuth 2.0 Web Application credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
