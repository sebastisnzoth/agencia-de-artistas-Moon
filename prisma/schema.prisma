generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum OpportunityStatus {
  NEW
  QUALIFIED
  CONTACTED
  NEGOTIATING
  PROPOSAL
  WON
  LOST
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACT_READY
  CONTACTED
  DISQUALIFIED
}

enum ConversationStatus {
  OPEN
  WAITING_FOR_REPLY
  REPLIED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DealStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
}

enum AutonomyLevel {
  A0
  A1
  A2
  A3
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  QUEUED
  SENT
  RECEIVED
  FAILED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  artists             Artist[]
  contacts            Contact[]
  opportunities       Opportunity[]
  leads               Lead[]
  conversations       Conversation[]
  approvals           Approval[]
  proposals           Proposal[]
  deals               Deal[]
  events              Event[]
  tasks               Task[]
  agentRuns           AgentRun[]
  toolPermissions     ToolPermission[]
  emailThreads        EmailThread[]
  integrationAccounts IntegrationAccount[]
  auditEvents         AuditEvent[]
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  createdAt           DateTime             @default(now())
  memberships         Membership[]
  integrationAccounts IntegrationAccount[]
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(MEMBER)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model IntegrationAccount {
  id                    String    @id @default(cuid())
  workspaceId           String
  userId                String
  provider              String
  externalAccountId     String
  email                 String?
  encryptedRefreshToken String
  scopes                String[]
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalAccountId])
  @@index([workspaceId, provider])
  @@index([userId, provider])
}

model Artist {
  id            String        @id @default(cuid())
  workspaceId   String
  stageName     String
  legalName     String?
  bio           String?
  genres        String[]
  languages     String[]
  territories   String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  leads         Lead[]
  conversations Conversation[]
  proposals     Proposal[]
  deals         Deal[]
  events        Event[]
  tasks         Task[]

  @@index([workspaceId])
}

model Contact {
  id            String        @id @default(cuid())
  workspaceId   String
  name          String
  email         String?
  organization  String?
  kind          String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  leads         Lead[]
  conversations Conversation[]
  emailThreads  EmailThread[]

  @@index([workspaceId])
  @@index([workspaceId, email])
}

model Opportunity {
  id            String            @id @default(cuid())
  workspaceId   String
  artistId      String
  contactId     String?
  title         String
  source        String?
  description   String?
  score         Int?
  status        OpportunityStatus @default(NEW)
  valueCents    Int?
  currency      String?           @default("USD")
  nextAction    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artist        Artist            @relation(fields: [artistId], references: [id], onDelete: Cascade)
  contact       Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leads         Lead[]
  conversations Conversation[]
  approvals     Approval[]
  proposals     Proposal[]
  deal          Deal?
  emailThreads  EmailThread[]
  tasks         Task[]

  @@index([workspaceId, status])
  @@index([artistId])
}

model Lead {
  id            String      @id @default(cuid())
  workspaceId   String
  artistId      String
  opportunityId String
  contactId     String?
  status        LeadStatus  @default(NEW)
  source        String?
  score         Int?
  notes         String?
  nextAction    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artist        Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, opportunityId])
  @@index([workspaceId, status])
  @@index([artistId, status])
  @@index([contactId])
}

model Conversation {
  id            String             @id @default(cuid())
  workspaceId   String
  artistId      String
  opportunityId String
  contactId     String?
  channel       String             @default("email")
  subject       String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artist        Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  emailThreads  EmailThread[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([opportunityId])
  @@index([contactId])
}

model Proposal {
  id            String         @id @default(cuid())
  workspaceId   String
  opportunityId String
  artistId      String
  version       Int            @default(1)
  title         String
  summary       String?
  terms         Json?
  amountCents   Int?
  currency      String         @default("USD")
  validUntil    DateTime?
  status        ProposalStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  artist        Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  approvals     Approval[]
  deal          Deal?

  @@unique([opportunityId, version])
  @@index([workspaceId, status])
}

model Approval {
  id            String         @id @default(cuid())
  workspaceId   String
  opportunityId String?
  proposalId    String?
  actionType    String
  summary       String
  payload       Json?
  status        ApprovalStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  resolvedAt    DateTime?
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposal      Proposal?      @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([proposalId])
}

model Deal {
  id            String      @id @default(cuid())
  workspaceId   String
  opportunityId String      @unique
  proposalId    String?     @unique
  artistId      String
  title         String
  amountCents   Int?
  currency      String      @default("USD")
  status        DealStatus  @default(DRAFT)
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposal      Proposal?   @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  artist        Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  events        Event[]

  @@index([workspaceId, status])
}

model Event {
  id          String    @id @default(cuid())
  workspaceId String
  artistId    String
  dealId      String?
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  timezone    String    @default("UTC")
  venue       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startsAt])
  @@index([artistId, startsAt])
}

model Task {
  id            String     @id @default(cuid())
  workspaceId   String
  artistId      String?
  opportunityId String?
  title         String
  notes         String?
  dueAt         DateTime?
  status        TaskStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artist        Artist?    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, dueAt])
  @@index([opportunityId])
}

model AgentRun {
  id              String         @id @default(cuid())
  workspaceId     String
  artistId        String?
  agentName       String
  taskType        String
  goal            String
  status          AgentRunStatus @default(QUEUED)
  autonomyLevel   AutonomyLevel  @default(A0)
  input           Json?
  output          Json?
  error           String?
  approvalsNeeded Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model ToolPermission {
  id            String        @id @default(cuid())
  workspaceId   String
  toolName      String
  enabled       Boolean       @default(false)
  autonomyLevel AutonomyLevel @default(A0)
  scopes        String[]
  constraints   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, toolName])
}

model EmailThread {
  id             String        @id @default(cuid())
  workspaceId    String
  opportunityId  String?
  contactId      String?
  conversationId String?
  provider       String
  externalId     String
  subject        String?
  lastMessageAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages       EmailMessage[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, lastMessageAt])
  @@index([conversationId])
}

model EmailMessage {
  id          String           @id @default(cuid())
  threadId    String
  externalId  String?
  direction   MessageDirection
  status      MessageStatus
  fromAddress String?
  toAddresses String[]
  subject     String?
  bodyText    String?
  sentAt      DateTime?
  receivedAt  DateTime?
  createdAt   DateTime         @default(now())
  thread      EmailThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, externalId])
  @@index([threadId, createdAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorType   String
  actorId     String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
